{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix services/dashboard-frontend run build",
  "outputDirectory": "services/dashboard-frontend/dist",
  "installCommand": "npm --prefix services/dashboard-frontend ci",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
